# Local synthetic-data development only. Generate fresh credentials before use.
DATABASE_URL=postgres://dpi:CHANGE_ME@127.0.0.1:55432/dpi
POSTGRES_PASSWORD=CHANGE_ME
API_TOKEN=GENERATE_A_RANDOM_TOKEN
PORT=4300
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Destination is optional until a separately configured FHIR receiver is ready.
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
# Optional OpenMRS pilot. Run the metadata setup after configuring credentials.
OPENMRS_BASE_URL=http://127.0.0.1:18081/openmrs/ws/rest/v1
DOCKER_OPENMRS_BASE_URL=http://host.docker.internal:18081/openmrs/ws/rest/v1
OPENMRS_USERNAME=
OPENMRS_PASSWORD=
OPENMRS_IDENTIFIER_TYPE=
OPENMRS_LOCATION=
OPENMRS_SYSTOLIC_CONCEPT=
OPENMRS_DIASTOLIC_CONCEPT=
# Separate hospital receiver. Resolve metadata with openmrs-setup.ts --hospital.
HOSPITAL_OPENMRS_BASE_URL=http://127.0.0.1:18082/openmrs/ws/rest/v1
HOSPITAL_OPENMRS_USERNAME=
HOSPITAL_OPENMRS_PASSWORD=
HOSPITAL_OPENMRS_IDENTIFIER_TYPE=
HOSPITAL_OPENMRS_LOCATION=
HOSPITAL_OPENMRS_SYSTOLIC_CONCEPT=
HOSPITAL_OPENMRS_DIASTOLIC_CONCEPT=
HOSPITAL_OPENMRS_REFERRAL_ENCOUNTER_TYPE=
HOSPITAL_OPENMRS_REFERRAL_NOTE_CONCEPT=

# Hospital feedback metadata (configured by scripts/feedback-setup.ts)
OPENMRS_OUTCOME_CONCEPT=
OPENMRS_FEEDBACK_ENCOUNTER_TYPE=
HOSPITAL_OPENMRS_OUTCOME_CONCEPT=

# Optional local ComEMR integration. Never commit credentials or linkage files.
COMEMR_BASE_URL=http://127.0.0.1:3000
COMEMR_USERNAME=
COMEMR_PASSWORD=
COMEMR_PASSWORD_HASH_KEY=spice_uat
COMEMR_CLIENT=web
COMEMR_LINK_FILE=secrets/comemr-link.json
